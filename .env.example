# Copy to .env for local overrides. NEVER commit real secrets.
# Compose reads this file automatically; the API reads INVOICEOPS_* vars.

# Master key for the LiteLLM proxy (also used by the api service as its gateway key)
LITELLM_MASTER_KEY=sk-local-dev

# LiteLLM routing profile: config.yaml (dev, Ollama) or config.prod.yaml (OpenAI)
# LITELLM_CONFIG=/etc/litellm/config.prod.yaml

# OpenAI key — only needed when running the prod/eval profile
# OPENAI_API_KEY=sk-...

# API service log level
LOG_LEVEL=INFO
