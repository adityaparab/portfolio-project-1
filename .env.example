# Copy to .env for local overrides. NEVER commit real secrets.
# Compose reads this file automatically; the API reads INVOICEOPS_* vars
# (pydantic-settings also loads this file directly). .env has NO variable
# interpolation — set paired values explicitly.

# ── LiteLLM gateway ─────────────────────────────────────────────────────────
# Where the API finds the OpenAI-compliant LiteLLM proxy.
#   native proxy on host + API in Compose : http://host.docker.internal:4000  ← default dev setup
#   native proxy + API on host (uv run)   : http://localhost:4000
#   optional self-hosted proxy service    : http://litellm:4000   (docker compose --profile proxy up)
INVOICEOPS_LITELLM_BASE_URL=http://host.docker.internal:4000

# Key your native proxy validates (required for model calls; /health/liveliness is open).
# Set BOTH vars to the same value.
LITELLM_API_KEY=sk-replace-with-native-proxy-key
INVOICEOPS_LITELLM_API_KEY=sk-replace-with-native-proxy-key

# Master key for the OPTIONAL self-hosted proxy service (--profile proxy)
LITELLM_MASTER_KEY=sk-local-dev

# Where the optional self-hosted proxy finds the native proxy upstream
NATIVE_PROXY_BASE_URL=http://host.docker.internal:4000/v1

# ── OpenAI (prod/eval profile only) ─────────────────────────────────────────
# OPENAI_API_KEY=sk-...
# LITELLM_CONFIG=/etc/litellm/config.prod.yaml

# ── API service ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
